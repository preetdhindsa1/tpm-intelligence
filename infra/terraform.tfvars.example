# Copy to terraform.tfvars (gitignored).
project_id     = "my-tpm-demo"
project_number = "123456789012"
region         = "us-central1"
image_tag      = "latest"
poll_release   = "v1.38"
approvers      = ["your-github-login"]
github_repo    = "owner/tpm-intelligence"

# Alerts go here (issue #14). Keep it in this gitignored file, never in code.
# alert_email = "you@example.com"

# Turn on once the API has made one AI call (Google rejects PromQL alerts on unwritten metrics).
