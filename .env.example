# Copy to .env (gitignored) and fill in. Never commit real values.

# GitHub personal access token, read-only (public_repo read is enough). Used by the poller.
GITHUB_TOKEN=

# Local overrides (docker compose sets these for containers).
DATABASE_URL=postgresql+psycopg://tpm:tpm@localhost:5432/tpm
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
QUEUE_BACKEND=redis        # redis (local) | pubsub (cloud)
PUBSUB_PROJECT_ID=
LOG_LEVEL=INFO
DEPLOY_ENV=local

# ---- AI (phase 2). Key from console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=
AI_MODEL_SIMPLE=claude-haiku-5-5      # cheaper model: link suggestions, per-feature notes
AI_MODEL_SUMMARY=claude-opus-5-5      # stronger model: executive summaries
AI_DAILY_BUDGET_USD=2.0               # slow non-essential calls at 80%, pause at 100%
AI_TRACE_CONTENT=true                 # prompts/outputs in spans (public data only)

# ---- Langfuse (self-hosted LLM traces: make langfuse-up -> http://localhost:3001)
# From containers use host.docker.internal; from the host use http://localhost:3001.
LANGFUSE_HOST=http://host.docker.internal:3001
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@tpm.local
LANGFUSE_INIT_USER_PASSWORD=change-me

# Sign-in and permissions (ADR-0016). Reading is public; actions need an approver.
#   AUTH_MODE=required (default): actions need a GitHub sign-in through the web app.
#   AUTH_MODE=local: development only; unsigned requests act as "local".
AUTH_MODE=local
# Shared by web and API to sign forwarded actions. Generate: openssl rand -hex 32
TPM_ACTION_SECRET=
# GitHub logins allowed to act, comma-separated.
APPROVERS=
# Auth.js (web). GitHub OAuth App: callback http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Development only: a "sign in as" form for testing without GitHub (refused in production).
AUTH_DEV_LOGIN=false
